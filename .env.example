# Canonical database (required)
DATABASE_URL="postgresql://cogdoc:cogdoc_dev@localhost:5432/cogdoc"

# Browser authentication (recommended for every multi-user deployment)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Private object storage
COGDOC_STORAGE_BUCKET="cogdoc-private"
# Local-development fallback when Supabase Storage is not configured:
COGDOC_STORAGE_DIR=".data/assets"

# Ed25519 PKCS#8 private PEM, either literal with escaped newlines or base64.
# Docker generates and persists one under /data when this is omitted.
COGDOC_CERTIFICATE_PRIVATE_KEY=""

# Analysis service and retrieval
FASTAPI_URL="http://localhost:8000"
USE_VECTOR_RETRIEVAL="false"

# OpenAI-compatible analysis provider
AI_PROVIDER="gemini"
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_API_KEY=""
AI_MODEL="gemini-2.0-flash"

# Local-only single-user fallback; ignored in production.
COGDOC_DEV_FALLBACK="1"
DAILY_TOKEN_BUDGET="100000"
IDLE_THRESHOLD="45"
