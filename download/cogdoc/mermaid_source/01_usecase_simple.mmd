%% Cogdoc — Simplified Use Case Diagram
%% One actor (Writer), 6 core use cases, no clutter
flowchart LR
    %% ── Actor ───────────────────────────────────────────────────────
    Writer((Writer))

    %% ── System boundary ─────────────────────────────────────────────
    subgraph SYS [Cogdoc]
        direction TB

        %% Core use cases only — what the writer actually does
        UC1([Create Project])
        UC2([Write Draft])
        UC3([Upload Sources])
        UC4([Find Sources Online])
        UC5([View Intervention])
        UC6([Export Draft])

        %% The 4 AI engines — shown as a single use case that includes them
        ENGINES([AI Engines Analyze<br/>Each Sentence])
    end

    %% ── Actor associations ──────────────────────────────────────────
    Writer --> UC1
    Writer --> UC2
    Writer --> UC3
    Writer --> UC4
    Writer --> UC5
    Writer --> UC6

    %% ── Includes ────────────────────────────────────────────────────
    UC2 -. <<include>> .-> ENGINES
    UC4 -. <<include>> .-> ENGINES

    %% ── Styling ────────────────────────────────────────────────────
    classDef actor fill:#EFF6FF,stroke:#226b90,stroke-width:2px,color:#181a1b
    classDef usecase fill:#f5f8fb,stroke:#354d59,stroke-width:1.5px,color:#181a1b
    classDef engine fill:#FFF7ED,stroke:#be6a4e,stroke-width:1.5px,color:#181a1b
    classDef system fill:#faf7f0,stroke:#78716c,stroke-width:1px,color:#181a1b

    class Writer actor
    class UC1,UC2,UC3,UC4,UC5,UC6 usecase
    class ENGINES engine
    class SYS system
