digraph CogdocUseCase {
    // ── Layout ─────────────────────────────────────────────────────────
    rankdir=LR
    splines=true
    overlap=false
    nodesep=0.5
    ranksep=1.5
    bgcolor="#faf7f0"
    fontname="Helvetica"
    label="Cogdoc — Use Case Diagram"
    labelloc="t"
    fontsize=20
    labeljust="c"

    // ── System boundary ────────────────────────────────────────────────
    subgraph cluster_system {
        label="Cogdoc System"
        fontname="Helvetica-Bold"
        fontsize=16
        style="rounded,filled"
        fillcolor="#f5f8fb"
        color="#354d59"
        penwidth=2.5

        // ── Core use cases ────────────────────────────────────────────
        UC_Create [label="Create Project", shape=ellipse, style="filled", fillcolor="#EFF6FF", color="#226b90", penwidth=1.8, fontname="Helvetica", fontsize=12]
        UC_Write  [label="Write Draft", shape=ellipse, style="filled", fillcolor="#EFF6FF", color="#226b90", penwidth=1.8, fontname="Helvetica", fontsize=12]
        UC_Upload [label="Upload Sources\n(PDF / Text)", shape=ellipse, style="filled", fillcolor="#EFF6FF", color="#226b90", penwidth=1.8, fontname="Helvetica", fontsize=12]
        UC_Find   [label="Find Sources\nOnline", shape=ellipse, style="filled", fillcolor="#FFF7ED", color="#be6a4e", penwidth=1.8, fontname="Helvetica", fontsize=12]
        UC_View   [label="View Intervention\n(hover underline)", shape=ellipse, style="filled", fillcolor="#EFF6FF", color="#226b90", penwidth=1.8, fontname="Helvetica", fontsize=12]
        UC_Act    [label="Take Action\n(Rewrite / Find /\nAnswer)", shape=ellipse, style="filled", fillcolor="#EFF6FF", color="#226b90", penwidth=1.8, fontname="Helvetica", fontsize=12]
        UC_Export [label="Export Draft\n(MD / TXT / HTML)", shape=ellipse, style="filled", fillcolor="#EFF6FF", color="#226b90", penwidth=1.8, fontname="Helvetica", fontsize=12]
        UC_Stats  [label="View Stats\n& History", shape=ellipse, style="filled", fillcolor="#EFF6FF", color="#226b90", penwidth=1.8, fontname="Helvetica", fontsize=12]

        // ── AI Engines (included use case) ────────────────────────────
        UC_Engines [label="AI Engines Analyze\nSentence\n\nSocrates · Diogenes\nGalileo · Aristotle", shape=ellipse, style="filled", fillcolor="#FFF7ED", color="#be6a4e", penwidth=2.5, fontname="Helvetica-Bold", fontsize=11]

        // ── Verify claim (extension) ──────────────────────────────────
        UC_Verify [label="Verify Claim\nagainst Library", shape=ellipse, style="filled", fillcolor="#d1fae5", color="#059669", penwidth=1.8, fontname="Helvetica", fontsize=12]
    }

    // ── Stickman actors (using HTML table with circle + lines) ────────
    // A clean stickman: head (circle), body (line), arms (T), legs (V)
    Writer [shape=plaintext, label=<
        <table border="0" cellborder="0" cellspacing="0" cellpadding="2">
            <tr><td align="center">
                <table border="0" cellborder="0" cellspacing="0" cellpadding="0">
                    <tr><td align="center" height="20"><font color="#226b90" point-size="22">&#9673;</font></td></tr>
                    <tr><td align="center" height="20"><font color="#226b90" point-size="22">&#124;</font></td></tr>
                    <tr><td align="center" height="14"><font color="#226b90" point-size="16">/ &#124; &#92;</font></td></tr>
                    <tr><td align="center" height="14"><font color="#226b90" point-size="16">/ &#92;</font></td></tr>
                </table>
            </td></tr>
            <tr><td align="center"><b><font color="#226b90" point-size="13">Writer</font></b></td></tr>
            <tr><td align="center"><font point-size="10" color="#52525b">(Student /<br/>Researcher)</font></td></tr>
        </table>
    >]

    LLM [shape=plaintext, label=<
        <table border="0" cellborder="0" cellspacing="0" cellpadding="2">
            <tr><td align="center">
                <table border="0" cellborder="0" cellspacing="0" cellpadding="0">
                    <tr><td align="center" height="20"><font color="#be6a4e" point-size="22">&#9673;</font></td></tr>
                    <tr><td align="center" height="20"><font color="#be6a4e" point-size="22">&#124;</font></td></tr>
                    <tr><td align="center" height="14"><font color="#be6a4e" point-size="16">/ &#124; &#92;</font></td></tr>
                    <tr><td align="center" height="14"><font color="#be6a4e" point-size="16">/ &#92;</font></td></tr>
                </table>
            </td></tr>
            <tr><td align="center"><b><font color="#be6a4e" point-size="13">LLM API</font></b></td></tr>
            <tr><td align="center"><font point-size="10" color="#52525b">(Gemini /<br/>Groq / OpenAI)</font></td></tr>
        </table>
    >]

    Web [shape=plaintext, label=<
        <table border="0" cellborder="0" cellspacing="0" cellpadding="2">
            <tr><td align="center">
                <table border="0" cellborder="0" cellspacing="0" cellpadding="0">
                    <tr><td align="center" height="20"><font color="#be6a4e" point-size="22">&#9673;</font></td></tr>
                    <tr><td align="center" height="20"><font color="#be6a4e" point-size="22">&#124;</font></td></tr>
                    <tr><td align="center" height="14"><font color="#be6a4e" point-size="16">/ &#124; &#92;</font></td></tr>
                    <tr><td align="center" height="14"><font color="#be6a4e" point-size="16">/ &#92;</font></td></tr>
                </table>
            </td></tr>
            <tr><td align="center"><b><font color="#be6a4e" point-size="13">Web Search</font></b></td></tr>
            <tr><td align="center"><font point-size="10" color="#52525b">(Internet)</font></td></tr>
        </table>
    >]

    // ── Writer associations (solid lines, no arrows) ──────────────────
    Writer -> UC_Create  [arrowhead=none, color="#226b90", penwidth=1.5]
    Writer -> UC_Write   [arrowhead=none, color="#226b90", penwidth=1.5]
    Writer -> UC_Upload  [arrowhead=none, color="#226b90", penwidth=1.5]
    Writer -> UC_Find    [arrowhead=none, color="#226b90", penwidth=1.5]
    Writer -> UC_View    [arrowhead=none, color="#226b90", penwidth=1.5]
    Writer -> UC_Export  [arrowhead=none, color="#226b90", penwidth=1.5]
    Writer -> UC_Stats   [arrowhead=none, color="#226b90", penwidth=1.5]

    // ── Include relationships (dashed, <<include>>) ────────────────────
    UC_Write  -> UC_Engines [style=dashed, arrowhead=vee, color="#78716c", penwidth=1.2, label=" <<include>> ", fontname="Helvetica-Oblique", fontsize=10, fontcolor="#78716c"]
    UC_Find   -> UC_Engines [style=dashed, arrowhead=vee, color="#78716c", penwidth=1.2, label=" <<include>> ", fontname="Helvetica-Oblique", fontsize=10, fontcolor="#78716c"]

    // ── Extend relationships (dashed, <<extend>>) ──────────────────────
    UC_Verify -> UC_View   [style=dashed, arrowhead=vee, color="#78716c", penwidth=1.2, label=" <<extend>> ", fontname="Helvetica-Oblique", fontsize=10, fontcolor="#78716c"]
    UC_Act    -> UC_View   [style=dashed, arrowhead=vee, color="#78716c", penwidth=1.2, label=" <<extend>> ", fontname="Helvetica-Oblique", fontsize=10, fontcolor="#78716c"]

    // ── External system associations (dashed) ─────────────────────────
    UC_Engines -> LLM   [arrowhead=none, style=dashed, color="#be6a4e", penwidth=1.3, label=" chat ", fontname="Helvetica-Oblique", fontsize=10, fontcolor="#be6a4e"]
    UC_Find    -> Web   [arrowhead=none, style=dashed, color="#be6a4e", penwidth=1.3, label=" search ", fontname="Helvetica-Oblique", fontsize=10, fontcolor="#be6a4e"]
    UC_Verify  -> LLM   [arrowhead=none, style=dashed, color="#be6a4e", penwidth=1.3, label=" verify ", fontname="Helvetica-Oblique", fontsize=10, fontcolor="#be6a4e"]
}
