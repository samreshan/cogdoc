    "noteMargin": 10,
    "messageMargin": 35,
    "mirrorActors": true,
    "useMaxWidth": true,
    "wrap": true
  },
  "er": {
    "diagramPadding": 20,
    "entityPadding": 15,
    "stroke": "#226b90",
    "fill": "#e4e6e7",
    "fontSize": 13,
    "useMaxWidth": true
  },
  "class": {
    "defaultRenderer": "dagre-d3"
  }
