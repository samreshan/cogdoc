%% Cogdoc — Writing Loop (how a sentence flows through the system)
%% Simplified to show the user-facing experience
flowchart LR
    WRITE[✍️ Writer types<br/>a sentence] --> DOT[. ? !<br/>sentence complete]
    DOT --> ANALYZE[📖 Cogdoc analyzes<br/>the sentence]
    ANALYZE --> FIRE{Which engines<br/>should fire?}

    FIRE -->|vague language| SOC[🦉 Socrates<br/>challenges vagueness]
    FIRE -->|factual claim| CIT[🐕 Galileo<br/>verifies claim]
    FIRE -->|idle pause| DIO[🦊 Diogenes<br/>provokes thinking]
    FIRE -->|long sentence| ARI[🦫 Aristotle<br/>offers scaffold]

    SOC --> UNDERLINE[🎯 Sentence gets<br/>colored underline]
    CIT --> UNDERLINE
    DIO --> UNDERLINE
    ARI --> UNDERLINE

    UNDERLINE --> HOVER[👆 Writer hovers]
    HOVER --> ACTIONS[📋 Actionable insights<br/>Find sources / Rewrite / Answer]
    ACTIONS --> WRITE

    %% Styling
    classDef start fill:#EFF6FF,stroke:#226b90,stroke-width:2px,color:#181a1b
    classDef decision fill:#FEF3C7,stroke:#92400e,stroke-width:2px,color:#181a1b
    classDef engine fill:#FFF7ED,stroke:#be6a4e,stroke-width:1.5px,color:#181a1b
    classDef action fill:#f5f8fb,stroke:#354d59,stroke-width:1.5px,color:#181a1b

    class WRITE,UNDERLINE,HOVER,ACTIONS start
    class DOT,ANALYZE,FIRE decision
    class SOC,CIT,DIO,ARI engine
